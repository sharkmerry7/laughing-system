{
  "manifest_version": 3,
  "name": "Cafe Menu Scraper",
  "version": "1.0",
  "description": "Extract menu data from Cafe Bon Appetit with one click",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "host_permissions": [
    "https://*.cafebonappetit.com/*"
  ]
}
